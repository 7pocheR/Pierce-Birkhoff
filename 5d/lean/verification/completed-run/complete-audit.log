    ∃ C, C.count = 5 ∧ (∀ (i : Fin C.count), (C.label i).totalDegree ≤ 3) ∧ ¬PBCounterexample.IsPolynomialLattice g
GRAM5_FINAL_TYPE PBCounterexample.Gram5.not_finite_sup_inf_polynomials ∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι)
  (hS : S.Nonempty) (T : ι → Finset κ) (hT : ∀ (i : ι), (T i).Nonempty) (p : ι → κ → MvPolynomial (Fin 5) ℝ),
  ¬∀ (z : Fin 5 → ℝ),
      PBCounterexample.Gram5.f z = S.sup' hS fun i => (T i).inf' ⋯ fun j => (MvPolynomial.eval z) (p i j)
GRAM5_FINAL_TYPE PBCounterexample.Gram5.not_isPolynomialLattice ¬PBCounterexample.IsPolynomialLattice
    PBCounterexample.Gram5.f
GRAM5_FINAL_TYPE PBCounterexample.Gram5.exists_finite_threshold_pair ∀ (S : Finset PBCounterexample.Gram5.Poly),
  ∃ x y,
    0 < PBCounterexample.Gram5.f x ∧
      PBCounterexample.Gram5.f y = 0 ∧
        ∀ P ∈ S, PBCounterexample.Gram5.f x ≤ (MvPolynomial.eval x) P → 0 < (MvPolynomial.eval y) P
GRAM5_FINAL_TYPE PBCounterexample.Gram5.exists_finite_threshold_paths ∀ (S : Finset PBCounterexample.Gram5.Poly),
  ∃ δ,
    0 < δ ∧
      δ < 1 / 2 ∧
        ∃ Fplus Fminus ε,
          0 < ε ∧
            |ε| < Fplus.radius ∧
              |ε| < Fminus.radius ∧
                ∀ᶠ (t : ℝ) in nhdsWithin 0 (Set.Ioi 0),
                  PBCounterexample.Gram5.f (Fplus.scaledPoint ε t) = 6 * t ^ 16 * ε ^ 2 * δ ^ 2 ∧
                    PBCounterexample.Gram5.f (Fminus.scaledPoint ε t) = 0 ∧
                      ∀ P ∈ S,
                        PBCounterexample.Gram5.f (Fplus.scaledPoint ε t) ≤
                            (MvPolynomial.eval (Fplus.scaledPoint ε t)) P →
                          0 < (MvPolynomial.eval (Fminus.scaledPoint ε t)) P
GRAM5_FINAL_TYPE PBCounterexample.Gram5.low_weight_kernel_formula ∀ (P : PBCounterexample.Gram5.Poly) (m : ℕ),
  MvPolynomial.IsWeightedHomogeneous PBCounterexample.Gram5.weights P m →
    m ≤ 16 →
      (MvPolynomial.eval PBCounterexample.Gram5.basePoint) P = 0 →
        (PBCounterexample.Gram5.differential P) PBCounterexample.Gram5.normalDirection = 0 →
          P =
            MvPolynomial.C (if m = 14 then MvPolynomial.coeff (PBCounterexample.Gram5.lowExponent 12) P else 0) *
                  PBCounterexample.Gram5.invariantA +
                MvPolynomial.C (if m = 15 then MvPolynomial.coeff (PBCounterexample.Gram5.lowExponent 15) P else 0) *
                  PBCounterexample.Gram5.invariantB +
              MvPolynomial.C (if m = 16 then MvPolynomial.coeff (PBCounterexample.Gram5.lowExponent 18) P else 0) *
                PBCounterexample.Gram5.invariantW
GRAM5_FINAL_TYPE PBCounterexample.Gram5.exists_implicitCorrection ∀ (δ σ : ℝ),
  0 < δ →
    σ ^ 2 = 1 →
      ∃ u η,
        0 < η ∧
          (∀ (ε t : ℝ), |ε| < η → |t| < η → PBCounterexample.Gram5.implicitResidual δ σ ((ε, t), u (ε, t)) = 0) ∧
            (∀ (ε t : ℝ), |ε| < η → |t| < η → ContDiffAt ℝ 1 u (ε, t)) ∧ ∀ (t : ℝ), |t| < η → u (0, t) = 0
GRAM5_FINAL_TYPE PBCounterexample.Gram5.LeafDecomposition.eventually_transfer_zero ∀ {P : PBCounterexample.Gram5.Poly}
  (L : PBCounterexample.Gram5.LeafDecomposition P) {δ : ℝ} (Fplus : PBCounterexample.Gram5.CorrectionFamily δ 1)
  (Fminus : PBCounterexample.Gram5.CorrectionFamily δ (-1)) (ε : ℝ),
  0 < ε →
    0 < δ →
      |ε| < Fplus.radius →
        |ε| < Fminus.radius →
          (∀ n ≤ 16, PBCounterexample.Gram5.component L.remainder n = 0) →
            ∀ᶠ (t : ℝ) in nhdsWithin 0 (Set.Ioi 0),
              6 * t ^ 16 * ε ^ 2 * δ ^ 2 ≤ (MvPolynomial.eval (Fplus.scaledPoint ε t)) P →
                0 < (MvPolynomial.eval (Fminus.scaledPoint ε t)) P
GRAM5_FINAL_TYPE PBCounterexample.WeightedPolynomial.tendsto_eval_scale_div ∀ {σ : Type u_1} (w : σ → ℕ)
  (p : MvPolynomial σ ℝ) (m : ℕ),
  (∀ n < m, (MvPolynomial.weightedHomogeneousComponent w n) p = 0) →
    ∀ {v : ℝ → σ → ℝ} {v₀ : σ → ℝ},
      Filter.Tendsto v (nhdsWithin 0 (Set.Ioi 0)) (nhds v₀) →
        Filter.Tendsto (fun t => (MvPolynomial.eval (PBCounterexample.WeightedPolynomial.scale w t (v t))) p / t ^ m)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds ((MvPolynomial.eval v₀) ((MvPolynomial.weightedHomogeneousComponent w m) p)))
